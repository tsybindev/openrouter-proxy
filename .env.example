# Ключ OpenRouter (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен, который ты будешь использовать на клиентах для обращения к своему прокси
# (он же пароль входа в Admin UI). Сгенерировать: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-my-super-secret-proxy-token

# Ключ для шифрования данных в БД (провайдерские ключи, добавленные через UI).
# Сгенерировать один раз и НИКОГДА не менять — иначе расшифровка сломается.
LITELLM_SALT_KEY=sk-generate-with-openssl-rand-hex-32

# Настройки Postgres для Admin UI / виртуальных ключей / spend-логов
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=litellm

# Домен и e-mail — нужны только для init-letsencrypt.sh
DOMAIN=wp.tsybindev.ru
EMAIL=you@example.com
