[nginx-llm-auth]
enabled  = true
filter   = nginx-llm-auth
logpath  = /root/openrouter-proxy/nginx/logs/access.log
# 10 неудачных попыток за 10 минут — бан на 1 час
maxretry = 10
findtime = 600
bantime  = 3600
# Пропускаем собственные запросы (если curl/тестируешь с localhost)
ignoreip = 127.0.0.1/8 ::1
# iptables-allports банит весь трафик с IP на все порты — самый простой
# и надёжный вариант в контейнерной среде. Если предпочитаешь ufw —
# замени action на: ufw[name=nginx-llm-auth, port=all, protocol=all]
action   = iptables-allports
